# =========================================================
# M.T.P.A. - Servicio de Integración IoT
# Variables de entorno (ver docs/broker-mqtt.md)
# =========================================================
#
# Copiar este archivo a ".env" (gitignoreado) y completar con
# las credenciales reales del cluster de HiveMQ Cloud. Nunca
# versionar el ".env" con valores reales.

MQTT_HOST=
MQTT_PORT=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=mtpa-dev

# ---------------------------------------------------------
# procesarMedicion (Cloud Function HTTPS)
# ---------------------------------------------------------
# URL de la función desplegada (o del emulador) y token Bearer.
# PROCESAR_MEDICION_TOKEN debe tener el mismo valor que
# INTEGRATION_SERVICE_TOKEN en las Cloud Functions. Nunca
# versionar valores reales.

PROCESAR_MEDICION_URL=
PROCESAR_MEDICION_TOKEN=

# Opcionales (se muestran los valores por defecto):
# PROCESAR_MEDICION_MAX_REINTENTOS=5
# PROCESAR_MEDICION_BACKOFF_MS=500

# ---------------------------------------------------------
# Órdenes de ventilador (Firestore, Admin SDK)
# ---------------------------------------------------------
# El servicio escucha la colección "ordenes_ventilador" de
# Firestore con Firebase Admin SDK, que necesita credenciales de
# una cuenta de servicio. GOOGLE_APPLICATION_CREDENTIALS es la ruta
# al archivo JSON con la clave de esa cuenta (Firebase Console >
# Configuración del proyecto > Cuentas de servicio). Guardar la clave
# fuera del repositorio; nunca versionarla.

GOOGLE_APPLICATION_CREDENTIALS=

# Opcional (se muestra el valor por defecto): antigüedad máxima, en
# segundos, de una orden pendiente. Pasado ese tiempo la orden se marca
# "expirada" y no se envía al ventilador.
# ORDEN_MAX_ANTIGUEDAD_SEGUNDOS=60

# Opcional (se muestra el valor por defecto): tiempo, en segundos, que una
# orden "enviada" espera la confirmación de estado del ventilador. Pasado ese
# tiempo sin respuesta, la orden se marca "fallida". Un barrido revisa las
# órdenes cada 10 segundos, así que la falla se ve entre este valor y este
# valor más 10 segundos después del envío. Un valor inválido se reemplaza
# por 30.
# ORDEN_CONFIRMACION_TIMEOUT_SEGUNDOS=30

# ---------------------------------------------------------
# Detección de dispositivos desconectados (Firestore, Admin SDK)
# ---------------------------------------------------------
# El servicio marca "estadoConexion: desconectado" a un dispositivo
# que no envía latidos ni mediciones durante más de 30 segundos
# (ver docs/contrato-mqtt.md). Todas son opcionales (se muestran
# los valores por defecto):
# - LATIDO_TIMEOUT_SEGUNDOS: silencio máximo antes de marcarlo
#   desconectado.
# - LATIDO_REVISION_SEGUNDOS: cada cuánto se revisa ese silencio.
# - LATIDO_REFRESCO_SEGUNDOS: cada cuánto, como máximo, se actualiza
#   "ultimaComunicacionEn" mientras el dispositivo sigue conectado
#   (evita escribir en Firestore con cada latido).
# - LATIDO_ESTABILIDAD_SEGUNDOS: tiempo que un dispositivo debe llevar
#   conectado sin cortes para resolver su alerta de desconexión (evita
#   abrir y cerrar alertas, y enviar correos, si la conexión es
#   intermitente).
# LATIDO_TIMEOUT_SEGUNDOS=30
# LATIDO_REVISION_SEGUNDOS=5
# LATIDO_REFRESCO_SEGUNDOS=60
# LATIDO_ESTABILIDAD_SEGUNDOS=60
